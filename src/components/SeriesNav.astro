---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const seriesName = post.data.series?.trim();

if (!seriesName) {
  return null;
}

const locale = Astro.currentLocale;
const allPosts = await getCollection("posts");
const filteredPosts = allPosts.filter(postFilter);

const seriesPosts = filteredPosts
  .filter(p => p.data.series?.trim() === seriesName)
  .sort((a, b) => {
    if (a.data.seriesOrder !== undefined && b.data.seriesOrder !== undefined) {
      return a.data.seriesOrder - b.data.seriesOrder;
    }
    return (
      new Date(a.data.pubDatetime).getTime() -
      new Date(b.data.pubDatetime).getTime()
    );
  });

const currentIndex = seriesPosts.findIndex(p => p.id === post.id);
const totalParts = seriesPosts.length;
const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex < totalParts - 1 ? seriesPosts[currentIndex + 1] : null;
---

<div class="border-border bg-card/80 my-8 rounded-xl border p-4 shadow-xs">
  <div class="flex items-center justify-between gap-2 border-b border-border/60 pb-3">
    <div class="flex items-center gap-2">
      <span class="text-accent text-lg">📌</span>
      <span class="text-sm font-semibold text-muted-foreground uppercase tracking-wider">
        Series:
      </span>
      <span class="font-bold text-foreground">{seriesName}</span>
    </div>
    <span class="bg-accent/10 text-accent rounded-full px-2.5 py-0.5 text-xs font-semibold">
      Part {post.data.seriesOrder ?? currentIndex + 1} of {totalParts}
    </span>
  </div>

  <details class="group mt-3">
    <summary class="focus-outline text-muted-foreground hover:text-accent flex cursor-pointer items-center justify-between text-xs font-medium select-none">
      <span>View all articles in this series</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-4 transition-transform duration-200 group-open:rotate-180"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>

    <ul class="mt-3 divide-y divide-border/40 text-sm">
      {
        seriesPosts.map((p, idx) => {
          const isCurrent = p.id === post.id;
          const partNum = p.data.seriesOrder ?? idx + 1;
          return (
            <li class:list={["py-2 flex items-center justify-between gap-2", { "font-bold text-accent": isCurrent }]}>
              <div class="flex items-center gap-2 overflow-hidden">
                <span class:list={["text-xs px-1.5 py-0.5 rounded font-medium shrink-0", isCurrent ? "bg-accent text-background" : "bg-muted text-muted-foreground"]}>
                  Part {partNum}
                </span>
                {isCurrent ? (
                  <span class="truncate">{p.data.title} <span class="text-xs font-normal opacity-75">(Current)</span></span>
                ) : (
                  <a
                    href={getPostUrl(p.id, p.filePath, locale)}
                    class="hover:text-accent truncate decoration-dashed underline-offset-4 hover:underline"
                  >
                    {p.data.title}
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </details>

  {
    (prevPost || nextPost) && (
      <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-2 border-t border-border/60 pt-3 text-xs">
        {prevPost ? (
          <a
            href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
            class="text-accent hover:underline flex items-center gap-1 font-medium me-auto"
          >
            ← Previous: {prevPost.data.title}
          </a>
        ) : <div />}
        {nextPost ? (
          <a
            href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
            class="text-accent hover:underline flex items-center gap-1 font-medium ms-auto"
          >
            Next: {nextPost.data.title} →
          </a>
        ) : <div />}
      </div>
    )
  }
</div>
