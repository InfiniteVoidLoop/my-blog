---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const filteredPosts = posts.filter(postFilter);

// Group posts by series
type GroupedSeries = {
  name: string;
  posts: typeof filteredPosts;
};

const seriesMap = new Map<string, typeof filteredPosts>();

for (const post of filteredPosts) {
  if (post.data.series) {
    const seriesName = post.data.series.trim();
    if (!seriesMap.has(seriesName)) {
      seriesMap.set(seriesName, []);
    }
    seriesMap.get(seriesName)!.push(post);
  }
}

const seriesList: GroupedSeries[] = Array.from(seriesMap.entries()).map(
  ([name, seriesPosts]) => {
    // Sort posts within series by seriesOrder first, then pubDatetime
    const sortedSeriesPosts = [...seriesPosts].sort((a, b) => {
      if (a.data.seriesOrder !== undefined && b.data.seriesOrder !== undefined) {
        return a.data.seriesOrder - b.data.seriesOrder;
      }
      return (
        new Date(a.data.pubDatetime).getTime() -
        new Date(b.data.pubDatetime).getTime()
      );
    });

    return {
      name,
      posts: sortedSeriesPosts,
    };
  }
);
---

<Layout title={`${t.pages.seriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.seriesTitle} pageDesc={t.pages.seriesDesc}>
    {
      seriesList.length === 0 ? (
        <p class="text-muted-foreground my-8 italic">No series available yet.</p>
      ) : (
        <div class="mt-6 flex flex-col gap-4">
          {seriesList.map(({ name, posts: seriesPosts }, index) => (
            <details
              class="group border-border bg-card hover:border-accent/50 rounded-xl border p-4 transition-all shadow-xs open:bg-card/90"
              open={index === 0}
            >
              <summary class="focus-outline flex cursor-pointer items-center justify-between font-semibold select-none list-none">
                <div class="flex items-center gap-3">
                  <span class="bg-accent/10 text-accent flex size-8 items-center justify-center rounded-lg text-lg">
                    📚
                  </span>
                  <span class="text-xl font-bold text-foreground hover:text-accent transition-colors">
                    {name}
                  </span>
                  <span class="border-border bg-muted text-muted-foreground rounded-full border px-2.5 py-0.5 text-xs font-medium">
                    {seriesPosts.length} {seriesPosts.length === 1 ? "article" : "articles"}
                  </span>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-5 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>

              <div class="mt-4 border-t border-border/60 pt-4">
                <ul class="divide-y divide-border/40">
                  {seriesPosts.map((post, postIdx) => (
                    <li class="py-3 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                      <div class="flex items-start gap-2">
                        <span class="text-xs font-semibold text-accent bg-accent/10 px-2 py-0.5 rounded mt-0.5 shrink-0">
                          Part {post.data.seriesOrder ?? postIdx + 1}
                        </span>
                        <a
                          href={getPostUrl(post.id, post.filePath, locale)}
                          class="font-medium text-foreground hover:text-accent decoration-dashed underline-offset-4 hover:underline transition-colors"
                        >
                          {post.data.title}
                        </a>
                      </div>
                      <p class="text-xs text-muted-foreground shrink-0 sm:ml-4">
                        {new Date(post.data.pubDatetime).toLocaleDateString(locale, {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        })}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))}
        </div>
      )
    }
  </Main>

  <Footer />
</Layout>
