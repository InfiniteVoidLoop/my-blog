---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

import workspaceBg from "@/assets/images/profile/workspace.jpg";
import avatar from "@/assets/images/profile/direct-face.jpg";
---

<Layout
  title={`Profile | ${config.site.title}`}
  description="Meet Phuc — Backend Developer, System Design Enthusiast, and Lifelong Learner."
>
  <Header />

  <!-- ── Hero Banner ── -->
  <div class="hero-banner relative w-full overflow-hidden">
    <Image
      src={workspaceBg}
      alt="Phúc's developer workspace"
      class="hero-img w-full block"
      quality={95}
      loading="eager"
    />

    <!-- Gradient overlay: transparent on top, opaque on bottom -->
    <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>

    <!-- Floating terminal easter-egg -->
    <div class="absolute top-6 right-8 hidden md:flex flex-col gap-0.5 font-mono text-xs text-green-400 select-none" aria-hidden="true">
      <span class="opacity-60">$ neofetch</span>
      <span class="opacity-50">OS: Arch Linux x86_64</span>
      <span class="opacity-50">WM: Hyprland</span>
      <span class="opacity-50">Shell: zsh</span>
      <span class="opacity-50">Editor: LazyVim</span>
    </div>

    <!-- Name block pinned to bottom of hero -->
    <div class="absolute bottom-0 left-0 right-0">
      <div class="max-w-3xl mx-auto px-4 pb-5 flex items-end gap-5">
        <!-- Avatar ring wrapper – overflows below hero -->
        <div class="avatar-wrapper relative shrink-0" style="margin-bottom: -56px;">
          <div class="avatar-ring">
            <Image
              src={avatar}
              alt="Phuc Dang"
              width={120}
              height={160}
              class="avatar-img"
              loading="eager"
            />
          </div>
          <span class="online-dot" aria-label="Online"></span>
        </div>

        <!-- Name + tagline -->
        <div class="pb-3 text-white">
          <h1 class="hero-name">Dang Vo Hong Phuc</h1>
          <p class="hero-sub">Backend Developer · System Design · Arch Linux</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Main content ── -->
  <main id="main-content" class="max-w-3xl mx-auto px-4 pb-12">
    <!-- Spacer to account for avatar overflow -->
    <div style="height: 64px;"></div>

    <!-- Skill pills -->
    <div class="pills-row">
      {[
        { icon: "🏗️", label: "Backend Dev" },
        { icon: "🗃️", label: "Database Design" },
        { icon: "⚡", label: "System Design" },
        { icon: "🐧", label: "Arch Linux" },
        { icon: "🔧", label: "LazyVim" },
        { icon: "☕", label: "C# · Python" },
      ].map(tag => (
        <span class="pill">
          <span>{tag.icon}</span>
          {tag.label}
        </span>
      ))}
    </div>

    <!-- Bio card -->
    <div class="card mb-5">
      <p class="text-base leading-relaxed mb-2">
        Hi, I'm <strong>Phuc</strong> 👋 — a backend software developer with a deep passion for system architecture, performance optimization, and clean database design.
      </p>
      <p class="text-sm leading-relaxed" style="color: var(--color-muted-foreground, #888);">
        Welcome to my digital space! I use this blog as my personal learning diary — a place to document new concepts, share insights, and reflect on the engineering challenges I solve day-to-day.
      </p>
    </div>

    <!-- 2-column grid -->
    <div class="content-grid">

      <!-- What I Do -->
      <div class="card">
        <h2 class="card-title">🚀 What I Do</h2>
        <ul class="do-list">
          {[
            { icon: "🏗️", title: "Backend & System Design", desc: "Deep dive in backend development, system architectures and system designs" },
            { icon: "🗃️", title: "Database Design & Optimization", desc: "Advanced knowledge in database design and optimization techniques" },
            { icon: "🔌", title: "Internet of Things (IoT)", desc: "Series of learning IoT from scratch" },
            { icon: "⚙️", title: "Operating System", desc: "General knowledge about realistic operating system techniques" },
          ].map(item => (
            <li class="do-item">
              <span class="do-icon">{item.icon}</span>
              <div>
                <div class="do-title">{item.title}</div>
                <div class="do-desc">{item.desc}</div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right column: Philosophy + Connect -->
      <div class="right-col">

        <!-- Philosophy -->
        <div class="card">
          <h2 class="card-title">🧠 My Philosophy</h2>
          <blockquote class="philosophy-quote">
            "The best way to understand a complex system is to build it, break it, and write about it."
          </blockquote>
          <p class="text-sm leading-relaxed mt-3" style="color: var(--color-muted-foreground, #888);">
            Writing is one of the most powerful tools for clarifying thoughts.
          </p>
        </div>

        <!-- Connect -->
        <div class="card">
          <h2 class="card-title">📫 Let's Connect</h2>
          <div class="connect-list">
            <a href="https://github.com/InfiniteVoidLoop" target="_blank" rel="noopener noreferrer" class="connect-btn">
              <svg class="connect-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
              <span>InfiniteVoidLoop</span>
              <svg class="ext-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <a href="mailto:ti20dangvohongphuc@gmail.com" class="connect-btn">
              <svg class="connect-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>ti20dangvohongphuc@gmail.com</span>
              <svg class="ext-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Footer note -->
    <p class="footer-note">
      Feel free to read through my posts, and don't hesitate to reach out! 🙌
    </p>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .hero-banner {
    position: relative;
    width: 100%;
  }

  /* Show top 55% of the image (the monitors area), not the floor */
  .hero-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  .hero-overlay {
    background: linear-gradient(
      to bottom,
      rgba(8, 12, 24, 0.25) 0%,
      rgba(8, 12, 24, 0.55) 50%,
      rgba(8, 12, 24, 0.92) 88%,
      rgba(8, 12, 24, 1)    100%
    );
  }

  .hero-name {
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    margin: 0;
  }

  .hero-sub {
    font-family: monospace;
    font-size: 0.82rem;
    color: #93c5fd;
    margin-top: 4px;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }

  /* ── Avatar ── */
  .avatar-wrapper {
    position: relative;
  }

  .avatar-ring {
    padding: 3px;
    border-radius: 16px;
    background: linear-gradient(135deg, #6366f1 0%, #06b6d4 50%, #a855f7 100%);
    box-shadow: 0 0 0 1px rgba(99,102,241,0.35), 0 8px 36px rgba(99,102,241,0.3);
  }

  /* Avatar: show the full face — no forced square crop */
  .avatar-img {
    display: block;
    width: 112px;
    height: 144px;        /* portrait ratio, shows full head + shoulders */
    object-fit: cover;
    object-position: center 15%; /* nudge slightly up to centre on face */
    border-radius: 13px;
  }

  .online-dot {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 14px;
    height: 14px;
    background: #34d399;
    border-radius: 50%;
    border: 2.5px solid var(--color-background, #fff);
    box-shadow: 0 0 0 2px rgba(52,211,153,0.35);
  }

  /* ── Skill pills ── */
  .pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid var(--color-border, #e5e7eb);
    background: var(--color-muted, #f3f4f6);
    color: var(--color-foreground, #111);
  }

  /* ── Cards ── */
  .card {
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 16px;
    padding: 24px;
    background: color-mix(in srgb, var(--color-muted, #f3f4f6) 40%, transparent);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    box-shadow: 0 6px 28px rgba(0,0,0,0.09);
    transform: translateY(-2px);
  }

  .card-title {
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── Content grid ── */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  @media (min-width: 640px) {
    .content-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .right-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── What I Do ── */
  .do-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .do-item {
    display: flex;
    gap: 12px;
    font-size: 0.83rem;
  }

  .do-icon {
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .do-title {
    font-weight: 600;
    color: var(--color-foreground, #111);
  }

  .do-desc {
    color: var(--color-muted-foreground, #888);
    margin-top: 2px;
    line-height: 1.5;
  }

  /* ── Philosophy ── */
  .philosophy-quote {
    border-left: 3px solid var(--color-accent, #6366f1);
    padding-left: 14px;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-muted-foreground, #888);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Connect ── */
  .connect-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .connect-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--color-border, #e5e7eb);
    font-size: 0.83rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground, #111);
    background: transparent;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .connect-btn:hover {
    background: color-mix(in srgb, var(--color-accent, #6366f1) 10%, transparent);
    border-color: var(--color-accent, #6366f1);
    color: var(--color-accent, #6366f1);
  }

  .connect-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .ext-icon {
    width: 12px;
    height: 12px;
    margin-left: auto;
    opacity: 0.35;
  }

  /* ── Footer note ── */
  .footer-note {
    font-size: 0.75rem;
    text-align: center;
    color: var(--color-muted-foreground, #888);
    font-style: italic;
    padding-top: 8px;
  }
</style>
